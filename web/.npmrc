# Disable pnpm 11+ supply-chain min-release-age check.
# Two transitive deps (baseline-browser-mapping, enhanced-resolve) were
# published <24h before the hackathon build, which the default policy rejects.
# Safe to relax here because the lockfile is committed and reviewed.
minimum-release-age=0
minimum-release-age-exclude=baseline-browser-mapping,enhanced-resolve
