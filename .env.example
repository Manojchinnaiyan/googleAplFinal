# StadiumOS — environment template. Copy to .env.local for local dev.
# Production values live in Secret Manager, not in this file.

# ── GCP core ────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=gen-lang-client-0636377017
GCP_PROJECT_NUMBER=406816938729
GCP_REGION=asia-south1
GCP_RUNTIME_SA=stadiumos-runtime@gen-lang-client-0636377017.iam.gserviceaccount.com
ARTIFACT_REGISTRY=asia-south1-docker.pkg.dev/gen-lang-client-0636377017/stadiumos

# ── Vertex AI / Gemini ──────────────────────────────────────────────────────
# Use Vertex (no key needed locally — auth via `gcloud auth application-default login`).
# Gemini 2.5 lives in us-central1 (not yet in asia-south1) — cross-region call, +~100ms.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=gen-lang-client-0636377017
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# ── Firestore ───────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ── Pub/Sub topics (created by Terraform later) ─────────────────────────────
TOPIC_CROWD_DENSITY=crowd.density
TOPIC_GATE_EVENT=gate.event
TOPIC_EMERGENCY=emergency.trigger
TOPIC_AGENT_DECISION=agent.decision
TOPIC_WEATHER=weather.update

# ── Optional external services (only if used in demo) ───────────────────────
# GOOGLE_MAPS_API_KEY=     # add via Secret Manager when Flow Router needs it
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# OPENWEATHER_API_KEY=
